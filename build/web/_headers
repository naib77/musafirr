# Cloudflare headers (this file is copied into build/web at build time).
#
# Flutter web no longer ships a caching service worker (the generated
# flutter_service_worker.js only unregisters older ones), so HTTP caching is
# the ONLY cache layer. Caching strategy — no client is ever stranded on a
# stale build:
#   * ENTRY POINTS (/, index.html, flutter_bootstrap.js, manifest/version/stamp)
#     are `no-cache, must-revalidate` — always revalidated, so a new deploy is
#     discovered on the very next load. ETags make the revalidation a cheap 304.
#   * The APP BUNDLE is content-hashed by tool/build_web.sh
#     (main.<hash>.dart.js) and referenced from the always-fresh
#     flutter_bootstrap.js, so it is safe to cache `immutable` forever: a new
#     build produces a new hash, an unchanged build reuses the cached bundle
#     (browser AND Cloudflare edge). This is the load-time win.
#   * Everything else Flutter emits with a stable-but-mutable URL (assets/*,
#     the local canvaskit/* fallback) stays `must-revalidate`.

/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/flutter_bootstrap.js
  Cache-Control: no-cache, no-store, must-revalidate

/flutter_service_worker.js
  Cache-Control: no-cache, no-store, must-revalidate

# Content-hashed app bundle (main.<hash>.dart.js) — safe to cache forever.
/main.*.dart.js
  Cache-Control: public, max-age=31536000, immutable

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

/version.json
  Cache-Control: no-cache, no-store, must-revalidate

/build_stamp.json
  Cache-Control: no-cache, no-store, must-revalidate

# NOT immutable: these URLs are stable across builds while their content
# changes (MaterialIcons-Regular.otf is re-tree-shaken every build). A
# long-lived immutable cache here strands users on stale assets for a month.
/assets/*
  Cache-Control: no-cache, must-revalidate

/canvaskit/*
  Cache-Control: no-cache, must-revalidate

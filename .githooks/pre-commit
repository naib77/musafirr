#!/bin/sh
# Formats staged Dart files before committing so CI's
# `dart format --set-exit-if-changed .` check never fails.

staged_dart_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.dart')

if [ -z "$staged_dart_files" ]; then
  exit 0
fi

echo "pre-commit: running dart format on staged files..."
echo "$staged_dart_files" | xargs dart format

# Re-stage the files so the formatted version is what gets committed
echo "$staged_dart_files" | xargs git add

exit 0

<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background layer: the brand rose, #C35063, measured from the
     solid interior of the supplied APP ICON artwork. The foreground layer is
     the mark knocked out in white, so this colour is what the icon reads as.

     A slight vertical gradient rather than a flat fill — a launcher icon sits
     against arbitrary wallpaper, and the shade gives it an edge without needing
     a border. Both stops are the brand hue, one a little deeper.

     Deliberately NOT theme-aware: the launcher icon is baked into the installed
     app and cannot follow the `active_theme` app setting, exactly as
     web/manifest.json cannot. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#A83E51"
        android:endColor="#C35063"
        android:type="linear" />
</shape>
